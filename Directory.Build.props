<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Shared C++ build policy for every project in Preview3D.slnx.
    See .docs/design/10-delivery-plan.md ("Repository transition"): C++20,
    Unicode, conformance mode, /permissive-, warning level 4, and
    warnings-as-errors for product code live here instead of drifting
    between per-project .vcxproj files.

    A hostile-worker attack binary (Gate 2's synthetic containment-test
    build) sets IsHostileTestBinary=true in its own .vcxproj to opt out of
    TreatWarningsAsErrors only; it still gets every other policy here.
  -->
  <PropertyGroup>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)'==''">10.0</WindowsTargetPlatformVersion>
    <PlatformToolset Condition="'$(PlatformToolset)'==''">v145</PlatformToolset>
    <CharacterSet Condition="'$(CharacterSet)'==''">Unicode</CharacterSet>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <ConformanceMode>true</ConformanceMode>
      <WarningLevel>Level4</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <AdditionalOptions>/permissive- /utf-8 %(AdditionalOptions)</AdditionalOptions>
      <!-- TreatWarningAsError (not the .NET-SDK-style "TreatWarningsAsErrors"
           property, which has no effect on VC++ ClCompile) is the actual
           /WX switch here. -->
      <TreatWarningAsError Condition="'$(IsHostileTestBinary)'!='true'">true</TreatWarningAsError>
    </ClCompile>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
</Project>
